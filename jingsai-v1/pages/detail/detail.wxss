/* S4 竞赛详情 · 档案袋版式 */
.detail-hero { position: relative; }
.detail-hero image { width: 100%; height: 420rpx; display: block; filter: saturate(.75); }
.veil {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(26, 24, 21, .35), rgba(26, 24, 21, .88));
}
.back-btn {
  position: absolute; left: 24rpx; top: 24rpx;
  padding: 0 24rpx; font-size: 48rpx; color: var(--paper);
  border: 2rpx solid rgba(244, 237, 223, .6); border-radius: 8rpx;
  line-height: 64rpx; background: rgba(26, 24, 21, .3);
}
.dt { position: absolute; left: 28rpx; right: 28rpx; bottom: 24rpx; }
.dt .pill { background: var(--cream); }
.dt-title { color: var(--paper); font-size: 42rpx; font-weight: 900; margin-top: 14rpx; line-height: 1.4; }
.org { font-size: 19rpx; color: rgba(244, 237, 223, .75); margin-top: 8rpx; letter-spacing: 2rpx; }

.meta-grid { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 3rpx solid var(--ink); }
.meta-cell { padding: 20rpx 28rpx; }
.meta-cell:first-child { border-right: 2rpx solid var(--ink); }
.meta-cell small { display: block; font-size: 16rpx; color: var(--ink-fade); letter-spacing: 3rpx; margin-bottom: 8rpx; }
.meta-cell b { font-size: 32rpx; font-weight: 900; }
.red { color: var(--verm); }

/* 时间轴 */
.tl { margin: 6rpx 28rpx 0 40rpx; border-left: 4rpx solid var(--ink); padding-left: 30rpx; }
.node { position: relative; padding: 14rpx 0; }
.node::before {
  content: ""; position: absolute; left: -41rpx; top: 24rpx;
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: var(--paper); border: 3rpx solid var(--ink);
}
.node.now::before { background: var(--marker); border-color: var(--ink); box-shadow: 0 0 0 4rpx rgba(245, 213, 71, .4); }
.node b { font-size: 28rpx; display: block; }
.node small { font-size: 19rpx; color: var(--ink-fade); }

/* 队伍要求 */
.team-req { display: flex; gap: 20rpx; margin: 0 28rpx; }
.tr-card {
  flex: 1; border: 3rpx solid var(--ink); background: var(--cream);
  padding: 22rpx; display: flex; flex-direction: column; gap: 8rpx;
  box-shadow: 5rpx 5rpx 0 var(--ink);
}
.tr-ic { font-size: 40rpx; color: var(--verm); }
.tr-card b { font-size: 32rpx; font-weight: 900; }
.tr-card small { font-size: 20rpx; color: var(--ink-soft); line-height: 1.7; }

/* 须知 */
.notice {
  margin: 0 28rpx; padding: 22rpx 26rpx;
  border: 3rpx solid var(--ink); background: var(--cream);
  font-size: 24rpx; line-height: 2; color: var(--ink-soft);
}
.notice b { color: var(--verm-deep); }
.notice-hand { font-size: 22rpx; color: var(--verm); margin-top: 6rpx; }

/* 底部操作条 */
.detail-foot {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 3rpx solid var(--ink);
  z-index: 20;
}
.fav-btn {
  width: 84rpx; height: 84rpx; line-height: 84rpx; text-align: center;
  border: 3rpx solid var(--ink); font-size: 40rpx; color: var(--ink-fade);
  background: var(--cream); border-radius: 8rpx;
}
.fav-btn.on { color: var(--verm); border-color: var(--verm); background: rgba(200, 68, 42, .08); }
.apply-btn { flex: 1; height: 88rpx; font-size: 30rpx; }

/* 给底部操作条留出滚动空间 */
page { padding-bottom: 160rpx; }
