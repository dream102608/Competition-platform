/* pages/detail/detail.wxss —— 竞赛详情 V3.0（参考图风格重排） */
.dt-cover {
  position: relative; margin: 20rpx 28rpx 0;
  border: 3rpx solid var(--ink); box-shadow: 6rpx 6rpx 0 var(--ink);
  border-radius: 16rpx; overflow: hidden;
}
.dt-cover image { width: 100%; height: 390rpx; display: block; }
.dt-flag {
  position: absolute; top: 20rpx; left: 0;
  background: var(--verm); color: var(--paper);
  padding: 8rpx 24rpx; font-size: 24rpx; letter-spacing: 4rpx; font-weight: 900;
}

.dt-main {
  margin: 24rpx 28rpx 0; padding: 28rpx;
  background: var(--cream); border: 3rpx solid var(--ink); border-radius: 20rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink); box-sizing: border-box;
}
.dt-title { font-size: 36rpx; font-weight: 900; line-height: 1.4; font-family: var(--serif); }
.dt-meta { font-size: 20rpx; color: var(--ink-soft); margin: 10rpx 0; }
.dt-tags { display: flex; gap: 10rpx; flex-wrap: wrap; margin: 12rpx 0; }
.dt-desc { font-size: 26rpx; color: var(--ink-soft); line-height: 1.8; margin-top: 10rpx; }

/* 各信息卡（统一大圆角） */
.dt-props, .dt-timeline, .dt-files, .dt-teams {
  margin: 0 28rpx 18rpx; padding: 18rpx 28rpx;
  background: var(--cream); border: 3rpx solid var(--ink); border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink); box-sizing: border-box;
}
.prop {
  display: flex; justify-content: space-between; gap: 12rpx;
  padding: 18rpx 0; border-bottom: 2rpx dashed var(--ink-fade); font-size: 24rpx;
}
.prop:last-child { border-bottom: none; }
.prop .k { color: var(--ink-soft); flex: none; }
.prop .v { font-weight: 700; text-align: right; }
.prop .v.yes { color: var(--green); }
.prop .v.verm { color: var(--verm); }

.tl-row { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 0; }
.tl-dot { width: 18rpx; height: 18rpx; border: 3rpx solid var(--ink); border-radius: 50%; flex-shrink: 0; }
.tl-row.now .tl-dot { background: var(--verm); border-color: var(--verm); }
.tl-body { flex: 1; min-width: 0; }
.tl-body b { font-size: 26rpx; display: block; }
.tl-body small { font-size: 20rpx; color: var(--ink-soft); }

.file-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; border-bottom: 2rpx dashed var(--ink-fade); }
.file-row:last-child { border-bottom: none; }
.fi-name { flex: 1; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fi-size { font-size: 18rpx; color: var(--ink-fade); }
.fi-dl { color: var(--verm); font-size: 24rpx; font-weight: 700; }

.tm-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 2rpx dashed var(--ink-fade); }
.tm-row:last-child { border-bottom: none; }
.tm-name { flex: 1; font-size: 26rpx; font-weight: 700; }
.tm-count { font-size: 20rpx; color: var(--ink-soft); }
.tm-empty { text-align: center; padding: 30rpx 0; color: var(--ink-soft); font-family: var(--hand); }

/* 底部固定报名栏（移动端底部安全区） */
.dt-foot {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; gap: 20rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--paper); border-top: 3rpx solid var(--ink);
}
.ft-fav { font-size: 24rpx; color: var(--ink-soft); padding: 0 10rpx; }
.ft-apply { flex: 1; height: 88rpx; font-size: 30rpx; }
.ft-apply.btn::after { border: none; }
/* 底部固定栏的内容占位：避免遮挡 */
.dt-foot-spacer { height: 140rpx; }
