/* pages/board/board.wxss —— 数据大屏（复古报纸风） */
.bd-mast { text-align: center; padding: 24rpx 28rpx 20rpx; border-bottom: 3rpx solid var(--ink); }
.bd-kicker { font-size: 18rpx; letter-spacing: 4rpx; color: var(--ink-fade); }
.bd-title { font-size: 48rpx; font-weight: 900; letter-spacing: 8rpx; margin: 10rpx 0 6rpx; }
.bd-sub { font-size: 18rpx; color: var(--ink-soft); letter-spacing: 2rpx; }

.bd-kpis { display: flex; gap: 14rpx; padding: 24rpx 28rpx 0; }
.bd-kpi {
  flex: 1; text-align: center; background: var(--cream);
  border: 2.4rpx solid var(--ink); box-shadow: 4rpx 4rpx 0 var(--ink);
  padding: 18rpx 0; border-radius: 12rpx; box-sizing: border-box;
}
.bd-kpi b { font-size: 42rpx; display: block; }
.bd-kpi.gold b { color: var(--verm); }
.bd-kpi small { font-size: 19rpx; color: var(--ink-soft); }

.bd-card {
  margin: 0 28rpx 24rpx; padding: 10rpx 24rpx 18rpx;
  background: var(--cream); border: 3rpx solid var(--ink); border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink); box-sizing: border-box;
}

.bd-row { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 0; border-bottom: 2rpx dashed var(--ink-fade); }
.bd-row:last-child { border-bottom: none; }
.bd-name { width: 240rpx; flex-shrink: 0; min-width: 0; }
.bd-name b { font-size: 22rpx; display: block; line-height: 1.35; }
.bd-name small { font-size: 17rpx; color: var(--verm); }
.bd-track { flex: 1; height: 26rpx; background: var(--paper); border: 2rpx solid var(--ink); }
.bd-bar { height: 100%; }
.bd-bar.verm { background: var(--verm); }
.bd-bar.ind { background: var(--ind); }
.bd-bar.green { background: var(--green); }
.bd-num { width: 64rpx; text-align: right; font-size: 24rpx; font-weight: 700; flex-shrink: 0; }

.bd-na { display: flex; gap: 18rpx; align-items: center; padding: 16rpx 0; border-bottom: 2rpx dashed var(--ink-fade); }
.bd-na:last-child { border-bottom: none; }
.bd-medal { width: 64rpx; height: 64rpx; font-size: 26rpx; flex-shrink: 0; }
.bd-na-info { flex: 1; min-width: 0; }
.bd-na-info b { font-size: 23rpx; display: block; line-height: 1.4; }
.bd-na-info small { font-size: 18rpx; color: var(--ink-soft); display: block; margin-top: 2rpx; }
.bd-na-t { color: var(--ink-fade); }

.bd-tail { text-align: center; font-size: 18rpx; color: var(--ink-fade); letter-spacing: 2rpx; padding: 10rpx 28rpx 40rpx; }
