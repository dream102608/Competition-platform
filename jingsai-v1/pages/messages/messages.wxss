/* pages/messages/messages.wxss —— S8 消息与催办中心（来函版式） */
.page { min-height: 100vh; background: var(--paper); padding: 0 32rpx 60rpx; box-sizing: border-box; }

.p-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 8rpx 20rpx; border-bottom: 2rpx solid var(--ink);
}
.t { font-size: 44rpx; font-weight: 900; letter-spacing: 4rpx; color: var(--ink); }
.head-act {
  font-size: 24rpx; color: var(--verm); border: 2rpx solid var(--verm);
  padding: 6rpx 18rpx; font-weight: 700;
}

.inbox-sub {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 20rpx; color: var(--ink-soft); padding: 20rpx 8rpx 4rpx;
}
.dot-live {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--verm); animation: blink 1.2s infinite;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

/* 来函卡片 */
.msg { display: flex; gap: 22rpx; padding: 26rpx 28rpx; margin-top: 22rpx; }
.msg.read { opacity: .62; }
.msg-stamp {
  flex-shrink: 0; width: 76rpx; height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 900; letter-spacing: 2rpx;
  transform: rotate(-6deg);
}
.t-notice  { background: var(--ind); color: var(--cream); border: 2rpx solid var(--ink); }
.t-approval{ background: var(--verm); color: var(--cream); border: 2rpx solid var(--verm-deep); }
.t-urge    { background: var(--marker); color: var(--ink); border: 2rpx solid var(--ink); }

.msg-body { flex: 1; min-width: 0; }
.msg-row { display: flex; align-items: center; gap: 12rpx; }
.msg-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.unread-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--verm); }
.msg-body-txt { font-size: 24rpx; color: var(--ink-soft); margin-top: 8rpx; line-height: 1.6; }
.msg-meta {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 19rpx; color: var(--ink-fade); margin-top: 14rpx;
}
.msg-go { color: var(--verm); font-weight: 700; }

.empty-box { padding: 60rpx 40rpx; text-align: center; margin-top: 24rpx; }
.empty-box .hand { font-size: 28rpx; color: var(--ink-soft); margin-bottom: 32rpx; }
.btn-s { display: inline-block; }
