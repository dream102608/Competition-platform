<view class="sbh" style="height:{{sbh}}px"></view>

<view class="p-head">
  <text class="t serif">报 名 受 理 单</text>
  <text class="pill mono" wx:if="{{comp}}">NO.{{comp.no}}</text>
</view>

<block wx:if="{{comp}}">
  <!-- 竞赛信息（只读） -->
  <view class="fm-comp card">
    <b class="serif">{{comp.title}}</b>
    <view class="fm-meta mono">{{comp.host}} · 截止 {{comp.deadline}} · {{comp.teamMin}}-{{comp.teamMax}} 人</view>
  </view>

  <!-- 基本信息（自动带入，可修改） -->
  <view class="sec-band"><view class="sq"></view><b>基 本 信 息</b><view class="ln"></view></view>
  <view class="fm-sec card">
    <view class="fm-row"><text class="k">姓名</text><text class="v">{{profile.name}}</text></view>
    <view class="fm-row"><text class="k">学号/工号</text><text class="v">{{profile.studentId || '（请在"我的"页完善）'}}</text></view>
    <view class="fm-row"><text class="k">学院专业</text><text class="v">{{profile.college}} {{profile.major}}</text></view>
    <view class="fm-row"><text class="k">手机号</text><text class="v">{{profile.phone || '（请在"我的"页完善）'}}</text></view>
    <view class="fm-tip hand">信息有误？去「我的 → 编辑资料」修改后自动带入。</view>
  </view>

  <!-- 报名模式 -->
  <view class="sec-band"><view class="sq"></view><b>报 名 模 式</b><view class="ln"></view></view>
  <view class="fm-modes" wx:if="{{comp.teamMax > 1}}">
    <view class="fm-mode {{mode === 'solo' ? 'on' : ''}}" data-m="solo" bindtap="switchMode">个人报名</view>
    <view class="fm-mode {{mode === 'team' ? 'on' : ''}}" data-m="team" bindtap="switchMode">组队报名</view>
  </view>

  <!-- 组队信息 -->
  <view class="fm-sec card" wx:if="{{mode === 'team' && comp.teamMax > 1}}">
    <view class="fm-label">队伍名称 <text class="req">*</text></view>
    <input class="fm-input hand" placeholder="起一个响亮的队名" value="{{teamName}}" bindinput="onTeamName"/>
    <view class="fm-label">队员名单（{{members.length}}/{{comp.teamMax}}）</view>
    <view class="member" wx:for="{{members}}" wx:key="index">
      <text class="m-name">{{item.name}}</text>
      <text wx:if="{{item.lead}}" class="pill red">队长</text>
      <text wx:else class="m-del" data-idx="{{index}}" bindtap="removeMember">移除</text>
    </view>
    <view class="m-add" wx:if="{{members.length < comp.teamMax}}">
      <input class="fm-input m-input" placeholder="输入队员姓名" value="{{memberInput}}" bindinput="onMemberInput"/>
      <button class="btn btn-line m-btn" bindtap="addMember">＋ 添加</button>
    </view>
  </view>

  <!-- 指导教师/辅导员（第1级审批人） -->
  <view class="sec-band" wx:if="{{comp.track !== 'teacher'}}"><view class="sq"></view><b>选 择 指 导 教 师 / 辅 导 员</b><view class="ln"></view></view>
  <view class="fm-sec card" wx:if="{{comp.track !== 'teacher'}}">
    <picker range="{{advisors}}" range-key="name" value="{{advisorIdx}}" bindchange="pickAdvisor">
      <view class="fm-picker">
        {{advisorIdx >= 0 ? advisors[advisorIdx].name + ' · ' + (advisors[advisorIdx].kind === 'counselor' ? '辅导员' : advisors[advisorIdx].title) + ' · ' + advisors[advisorIdx].org : '点击选择（系统默认优先指导教师）'}} ▾
      </view>
    </picker>
    <view class="fm-tip hand">此人将成为第 1 级审批人；无指导教师的项目建议选辅导员。</view>
  </view>

  <!-- 补充信息 -->
  <view class="sec-band"><view class="sq"></view><b>补 充 信 息</b><view class="ln"></view></view>
  <view class="fm-sec card">
    <view class="fm-label">个人简介</view>
    <textarea class="fm-textarea" placeholder="简单介绍自己 / 团队的参赛优势" value="{{intro}}" bindinput="onIntro"/>
    <view class="fm-label">GitHub / 作品集链接</view>
    <input class="fm-input" placeholder="https://github.com/...（选填）" value="{{github}}" bindinput="onGithub"/>
    <view class="fm-label">获奖经历</view>
    <textarea class="fm-textarea" placeholder="往届竞赛获奖情况（选填）" value="{{awards}}" bindinput="onAwards"/>
  </view>

  <!-- 附件上传 -->
  <view class="sec-band"><view class="sq"></view><b>附 件 上 传</b><view class="ln"></view></view>
  <view class="fm-sec card">
    <button class="btn btn-line fm-upload" bindtap="upload">{{uploading ? '上传中…' : '📎 选择文件（简历/计划书 PDF·Word·图片）'}}</button>
    <view class="fm-file" wx:if="{{planFile}}">✓ {{planFile}}</view>
  </view>

  <!-- 提交 -->
  <view class="fm-cta">
    <button class="btn btn-verm fm-submit {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中…' : '提 交 报 名'}}
    </button>
    <view class="fm-notice mono">提交即代表同意《参赛承诺与诚信声明》</view>
  </view>
</block>
