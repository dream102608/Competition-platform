/* pages/form/form.wxss —— 报名表单 V3.0（参考图风格重排） */
.fm-comp {
  margin: 20rpx 28rpx 0; padding: 24rpx 28rpx;
  background: var(--cream); border: 3rpx solid var(--ink); border-radius: 20rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink); box-sizing: border-box;
}
.fm-comp b { font-size: 30rpx; font-weight: 900; }
.fm-meta { font-size: 20rpx; color: var(--ink-soft); margin-top: 8rpx; }

.fm-sec {
  margin: 0 28rpx 8rpx; padding: 24rpx 28rpx;
  background: var(--cream); border: 3rpx solid var(--ink); border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink); box-sizing: border-box;
}
.fm-row { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 26rpx; }
.fm-row .k { color: var(--ink-soft); }
.fm-tip { margin-top: 14rpx; font-size: 22rpx; color: var(--verm-deep); }

.fm-modes { display: flex; gap: 16rpx; margin: 0 28rpx 20rpx; }
.fm-mode {
  flex: 1; text-align: center; padding: 22rpx 0; box-sizing: border-box;
  border: 2.4rpx solid var(--ink); background: var(--paper);
  font-family: var(--serif); font-weight: 900; letter-spacing: 4rpx;
  border-radius: 999rpx; font-size: 26rpx;
}
.fm-mode.on {
  background: var(--ink); color: var(--paper);
  box-shadow: 3rpx 3rpx 0 rgba(26, 24, 21, .35);
}

.fm-label { font-size: 24rpx; font-weight: 700; margin: 18rpx 0 10rpx; font-family: var(--serif); letter-spacing: 1rpx; }
.fm-label .req { color: var(--verm); }
.fm-input {
  border: 2.4rpx solid var(--ink); background: var(--paper-2);
  padding: 14rpx 18rpx; font-size: 26rpx; border-radius: 12rpx; box-sizing: border-box;
  width: 100%;
}
.fm-textarea {
  border: 2.4rpx solid var(--ink); background: var(--paper-2);
  padding: 14rpx 18rpx; font-size: 26rpx; width: 100%;
  min-height: 120rpx; border-radius: 12rpx; box-sizing: border-box;
}
.fm-picker {
  border: 2.4rpx solid var(--ink); background: var(--paper-2);
  padding: 16rpx 18rpx; font-size: 26rpx; border-radius: 12rpx; box-sizing: border-box;
}

.member {
  display: flex; align-items: center; gap: 16rpx;
  padding: 12rpx 0; border-bottom: 2rpx dashed var(--ink-fade);
}
.m-name { flex: 1; font-size: 26rpx; }
.m-del { color: var(--verm); font-size: 22rpx; }
.m-add { display: flex; gap: 14rpx; margin-top: 16rpx; }
.m-input { flex: 1; }
.m-btn { width: 150rpx; height: 72rpx; font-size: 24rpx; letter-spacing: 2rpx; }
.m-btn.btn::after { border: none; }

.fm-upload { width: 100%; height: 84rpx; font-size: 24rpx; letter-spacing: 2rpx; }
.fm-upload.btn::after { border: none; }
.fm-file { margin-top: 14rpx; font-size: 24rpx; color: var(--green); }

.fm-cta { padding: 30rpx 28rpx 60rpx; }
.fm-submit { width: 100%; height: 96rpx; font-size: 32rpx; }
.fm-submit.btn::after { border: none; }
.fm-submit.disabled { opacity: .5; }
.fm-notice { text-align: center; font-size: 18rpx; color: var(--ink-fade); margin-top: 16rpx; letter-spacing: 2rpx; }
