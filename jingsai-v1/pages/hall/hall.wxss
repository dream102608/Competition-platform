/* S3 竞赛大厅 · 分类广告版式 */
.h-ic { font-size: 38rpx; color: var(--ink); }

.hall-tabs { display: flex; gap: 20rpx; padding: 22rpx 28rpx 6rpx; }
.ht {
  font-family: "Noto Serif SC", "SimSun", serif;
  font-weight: 900; font-size: 26rpx; letter-spacing: 6rpx;
  padding: 12rpx 30rpx; color: var(--paper);
  background: var(--ink); border: 3rpx solid var(--ink);
}
.ht.on { background: var(--verm); border-color: var(--verm-deep); }
.ht:not(.on) { opacity: .35; }

.searchbar {
  display: flex; align-items: center; gap: 14rpx;
  margin: 16rpx 28rpx 0; padding: 16rpx 20rpx;
  border: 3rpx solid var(--ink); background: var(--cream);
}
.s-ic { font-size: 30rpx; color: var(--ink-fade); }
.s-input { flex: 1; font-size: 24rpx; }
.ph { color: var(--ink-fade); }

.filter-chips { display: flex; gap: 14rpx; padding: 20rpx 28rpx 6rpx; }
.fchip {
  font-size: 22rpx; padding: 6rpx 20rpx;
  border: 2.4rpx solid var(--ink); color: var(--ink-soft);
  background: transparent; letter-spacing: 2rpx;
}
.fchip.on { background: var(--marker); color: var(--ink); border-color: var(--ink); box-shadow: 3rpx 3rpx 0 var(--ink); }

/* 推荐位 */
.promo {
  display: flex; align-items: center; gap: 20rpx;
  margin: 20rpx 28rpx; padding: 16rpx;
  border: 3rpx solid var(--ink); background: var(--cream);
  box-shadow: 8rpx 8rpx 0 var(--ink);
}
.promo image { width: 220rpx; height: 160rpx; flex-shrink: 0; filter: saturate(.75); border: 2rpx solid var(--ink); }
.pm { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.pm b { font-size: 26rpx; line-height: 1.5; }
.pm small { font-size: 20rpx; color: var(--ink-fade); line-height: 1.6; }
.bar-prog { height: 10rpx; border: 2rpx solid var(--ink); }
.bar-prog i { display: block; height: 100%; width: 62%; background: var(--verm); }

/* 竞赛卡片 */
.comp-card {
  position: relative;
  display: flex; gap: 20rpx;
  margin: 24rpx 28rpx; padding: 16rpx;
  border: 3rpx solid var(--ink); background: var(--cream);
  box-shadow: 8rpx 8rpx 0 var(--ink);
}
.comp-card:active { transform: translate(2rpx, 2rpx); box-shadow: 5rpx 5rpx 0 var(--ink); }
.comp-card.closed { opacity: .55; box-shadow: none; }
.comp-card.closed .thumb image { filter: saturate(.2); }

/* 级别邮戳：A 朱砂 / B 靛蓝 / C 墨灰 */
.lvl {
  position: absolute; right: -6rpx; top: -14rpx; z-index: 2;
  font-size: 19rpx; font-family: "JetBrains Mono", Consolas, monospace;
  color: var(--paper); padding: 6rpx 14rpx; letter-spacing: 2rpx;
  transform: rotate(3deg);
  border: 2rpx solid var(--ink);
}
.lvl.A { background: var(--verm); }
.lvl.B { background: var(--ind); }
.lvl.C { background: var(--ink-fade); }

.thumb { width: 180rpx; height: 240rpx; flex-shrink: 0; border: 2rpx solid var(--ink); overflow: hidden; }
.thumb image { width: 100%; height: 100%; filter: saturate(.55); }

.info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.r1 { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.team-size { font-size: 18rpx; color: var(--ink-fade); }
.ct { font-size: 28rpx; font-weight: 900; line-height: 1.5; }
.cdesc { font-size: 20rpx; color: var(--ink-soft); margin: 10rpx 0 auto; line-height: 1.7; }
.meta { display: flex; align-items: baseline; gap: 16rpx; margin-top: 8rpx; }
.ddl { font-size: 19rpx; color: var(--verm); }
.ddl-hand { font-size: 26rpx; color: var(--verm); }

.hall-foot { margin: 30rpx 0 40rpx; text-align: center; color: var(--ink-fade); font-size: 25rpx; }
