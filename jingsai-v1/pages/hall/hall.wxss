/* pages/hall/hall.wxss —— 竞赛大厅 V3.0（参考图风格重排） */

/* 双赛道切换（参考图分类大圆角胶囊） */
.track-bar {
  display: flex; gap: 14rpx; margin: 16rpx 28rpx 0;
}
.trk {
  flex: 1; height: 76rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--serif); font-size: 28rpx; font-weight: 700;
  letter-spacing: 4rpx; color: var(--ink);
  background: var(--cream);
  border: 2.4rpx solid var(--ink); border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 var(--ink);
}
.trk.on {
  background: var(--ink); color: var(--paper); border-color: var(--ink);
  box-shadow: 3rpx 3rpx 0 rgba(26, 24, 21, .35);
}

/* 竞赛卡片（保留水墨硬边 + 加大圆角） */
.comp-card {
  display: flex; margin: 18rpx 28rpx;
  background: var(--cream);
  border: 3rpx solid var(--ink); border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink);
  overflow: hidden; box-sizing: border-box;
}
.comp-card.closed { opacity: .7; }
.cc-cover { width: 210rpx; height: 158rpx; flex-shrink: 0; border: 2rpx solid var(--ink); margin: 6rpx 0 6rpx 6rpx; align-self: center; }
.cc-body { flex: 1; padding: 18rpx 22rpx; min-width: 0; }
.cc-title {
  font-family: var(--serif); font-size: 28rpx; font-weight: 700;
  letter-spacing: 1rpx; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.cc-host { color: var(--ink-soft); font-size: 20rpx; margin: 6rpx 0 10rpx; }
.cc-tags { display: flex; gap: 10rpx; flex-wrap: wrap; }
.cc-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 12rpx; font-size: 18rpx; color: var(--ink-soft);
  border-top: 2rpx dashed var(--ink-fade); padding-top: 10rpx;
}
.cc-foot .hot { color: var(--verm); font-weight: 700; }
