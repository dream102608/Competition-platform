<view class="sbh" style="height:{{sbh}}px"></view>

<!-- 报头（保留水墨） -->
<view class="p-head">
  <text class="t serif">竞 赛 大 厅</text>
  <text class="pill mono">{{comps.length}} 项</text>
</view>

<!-- 双赛道切换（参考图分类大圆角） -->
<view class="track-bar">
  <view class="trk {{track === item.key ? 'on' : ''}}" wx:for="{{trackTabs}}" wx:key="key"
        data-key="{{item.key}}" bindtap="switchTrack">{{item.name}}</view>
</view>

<!-- 胶囊搜索 -->
<view class="search-pill">
  <input class="input" placeholder="搜索竞赛名称 / 编号 / 主办方"
         value="{{keyword}}" bindinput="onSearch" confirm-type="search"/>
  <view class="btn serif" bindtap="noop">搜 索</view>
</view>

<!-- 分类筛选（横滑 chip） -->
<scroll-view scroll-x class="chips">
  <text class="chip {{filter === f ? 'on' : ''}}" wx:for="{{filters}}" wx:for-item="f" wx:key="*this"
        data-f="{{f}}" bindtap="setFilter">{{f}}</text>
</scroll-view>

<!-- 竞赛卡片列表 -->
<view class="comp-card card {{item.closed ? 'closed' : ''}}" wx:for="{{comps}}" wx:key="_id"
      data-id="{{item._id}}" bindtap="goDetail">
  <image class="cc-cover" src="{{item.cover}}" mode="aspectFill"/>
  <view class="cc-body">
    <view class="cc-title serif">{{item.title}}</view>
    <view class="cc-host">{{item.host}}</view>
    <view class="cc-tags">
      <text class="pill">{{item.levelName}}</text>
      <text class="pill">{{item.category}}</text>
      <text class="st-pill {{item.closed ? 'st-rej' : 'st-run'}}">{{item.statusText}}</text>
    </view>
    <view class="cc-foot mono">
      <text>{{item.teamMin}}-{{item.teamMax}} 人组队</text>
      <text class="ddl {{item.closed ? '' : 'hot'}}">⏳ 剩余 {{item.ddlDays}}</text>
    </view>
  </view>
</view>

<view wx:if="{{comps.length === 0}}" class="empty hand">这个分类下暂时没有竞赛，换个筛选试试。</view>
<view class="tail">— 共 {{comps.length}} 项 —</view>
