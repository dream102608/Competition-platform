/* pages/checkin/checkin.wxss —— 签到打卡与积分 */
.ck-account { display: flex; margin: 20rpx 28rpx; }
.ac-item { flex: 1; text-align: center; padding: 24rpx 0; }
.ac-item b { font-size: 44rpx; display: block; }
.ac-item .verm { color: var(--verm); }
.ac-item small { font-size: 20rpx; color: var(--ink-soft); }

.ck-scenes { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 28rpx 8rpx; }
.ck-scene { width: calc(33.3% - 11rpx); text-align: center; padding: 22rpx 0; }
.ck-scene b { font-size: 26rpx; display: block; }
.ck-pt { display: block; color: var(--verm); font-size: 24rpx; font-weight: 700; margin: 6rpx 0; }
.ck-scene small { font-size: 18rpx; color: var(--ink-fade); }

.ck-rec { margin: 0 28rpx 20rpx; padding: 8rpx 24rpx; }
.ck-row { display: flex; gap: 14rpx; align-items: center; padding: 14rpx 0; border-bottom: 2rpx dashed var(--ink-fade); font-size: 22rpx; }
.ck-row:last-child { border-bottom: none; }
.ck-scene-name { flex: 1; font-weight: 700; }
.ck-loc { color: var(--ink-fade); font-size: 17rpx; max-width: 180rpx; overflow: hidden; }
.ck-time { color: var(--ink-fade); font-size: 17rpx; }
.ck-empty { text-align: center; padding: 30rpx 0; color: var(--ink-soft); }

/* ---------- 全院积分排行榜 ---------- */
.ck-rank { margin: 0 28rpx 40rpx; padding: 8rpx 24rpx; }
.rk-row { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 0; border-bottom: 2rpx dashed var(--ink-fade); }
.rk-row:last-child { border-bottom: none; }
.rk-no {
  width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; flex-shrink: 0;
  border: 2rpx solid var(--ink-soft); color: var(--ink-soft); font-size: 22rpx; border-radius: 50%;
}
.rk-no.rk-top { border-color: var(--verm); color: var(--verm); font-size: 26rpx; font-weight: 700; }
.rk-info { flex: 1; min-width: 0; }
.rk-info b { font-size: 26rpx; display: block; letter-spacing: 1rpx; }
.rk-info small { font-size: 18rpx; color: var(--ink-soft); }
.rk-pt { font-size: 26rpx; font-weight: 700; color: var(--verm); }

/* ---------- 地图定位确认弹窗 ---------- */
.ck-map { width: 100%; height: 420rpx; border: 2.4rpx solid var(--ink); margin-bottom: 12rpx; }
.map-addr { font-size: 19rpx; color: var(--ink-soft); }

/* 弹窗基础用 app.wxss 通用 */
.ex-meta { font-size: 20rpx; color: var(--ink-soft); margin-bottom: 14rpx; }
.kn-textarea { width: 100%; box-sizing: border-box; min-height: 140rpx; border: 2.4rpx solid var(--ink); background: var(--paper-2); padding: 16rpx; font-size: 26rpx; border-radius: 12rpx; }
