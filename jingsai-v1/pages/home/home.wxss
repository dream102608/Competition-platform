/* S2 首页 · 早报版式 */
.paper-mast { padding: 26rpx 28rpx 18rpx; border-bottom: 4rpx solid var(--ink); }
.paper-mast .date { display: flex; justify-content: space-between; font-size: 19rpx; letter-spacing: 3rpx; color: var(--ink-soft); }
.paper-mast .mast-title { font-size: 76rpx; font-weight: 900; letter-spacing: 6rpx; margin: 14rpx 0 8rpx; }
.paper-mast .slogan { font-size: 18rpx; letter-spacing: 6rpx; color: var(--ink-fade); }

/* 跑马灯 */
.ticker { display: flex; align-items: center; border-bottom: 2rpx solid var(--ink); background: var(--cream); }
.ticker .tag { font-size: 20rpx; color: var(--paper); background: var(--verm); padding: 8rpx 14rpx; flex-shrink: 0; }
.ticker-box { overflow: hidden; white-space: nowrap; flex: 1; padding: 8rpx 0; }
.ticker .txt {
  display: inline-block; white-space: nowrap;
  font-size: 24rpx; color: var(--ink-soft);
  animation: marquee 14s linear infinite;
}
@keyframes marquee {
  0% { transform: translateX(20%); }
  100% { transform: translateX(-100%); }
}

/* 头版 Banner */
.home-banner { position: relative; margin: 22rpx 28rpx; border: 3rpx solid var(--ink); }
.home-banner image { width: 100%; height: 300rpx; display: block; filter: saturate(.8) contrast(1.02); }
.home-banner .flag {
  position: absolute; right: -8rpx; top: 18rpx;
  background: var(--verm); color: var(--paper);
  font-size: 24rpx; padding: 6rpx 18rpx; letter-spacing: 4rpx;
  transform: rotate(-4deg);
}
.home-banner .cap {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--ink); color: var(--paper);
  padding: 16rpx 22rpx; font-size: 28rpx; letter-spacing: 2rpx;
}
.home-banner .cap-arrow { color: var(--verm); font-size: 32rpx; }

/* 功能宫格 */
.grid-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin: 0 28rpx; }
.g-item {
  position: relative;
  border: 3rpx solid var(--ink); background: var(--cream);
  box-shadow: 6rpx 6rpx 0 var(--ink);
  padding: 24rpx 22rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.g-item:active { transform: translate(2rpx, 2rpx); box-shadow: 4rpx 4rpx 0 var(--ink); }
.g-item .g-ic { font-size: 34rpx; color: var(--ink); margin-bottom: 6rpx; }
.g-item .g-ic.verm { color: var(--verm); }
.g-item b { font-size: 30rpx; font-weight: 900; letter-spacing: 2rpx; }
.g-item small { font-size: 20rpx; color: var(--ink-fade); letter-spacing: 1rpx; }

/* 报名进度卡 */
.prog-card { margin: 30rpx 28rpx 40rpx; padding: 24rpx; }
.pc-t { display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid var(--ink); padding-bottom: 14rpx; }
.pc-t b { font-size: 30rpx; letter-spacing: 8rpx; }
.pc-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 4rpx; border-bottom: 2rpx dashed var(--paper-4); }
.pc-row:last-child { border-bottom: none; }
.pc-row .num { font-size: 30rpx; font-weight: 700; color: var(--verm); }
.pc-info { flex: 1; min-width: 0; }
.pc-info b { display: block; font-size: 25rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-info small { font-size: 17rpx; color: var(--ink-fade); }
.pc-track { display: flex; align-items: center; }
.pc-track .dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  border: 3rpx solid var(--ink); margin-right: 14rpx;
}
.pc-track .dot.done { background: var(--verm); border-color: var(--verm); }
.pc-row .ver { font-size: 18rpx; color: var(--verm); border: 2rpx solid var(--verm); padding: 2rpx 8rpx; }
.pc-empty { text-align: center; padding: 30rpx 0; font-size: 28rpx; color: var(--verm); }
