/* pages/home/home.wxss —— 首页 V3.0（参考图风格重排）
   设计：地址条 + 胶囊搜索 + 大轮播 + 2×5 圆图标宫格 + 特色 banner + 列表
   保留：水墨报头、条码、学院章、印章、奖牌、硬边卡片等元素
*/

/* ========== 报头（保留水墨） ========== */
.paper-mast {
  text-align: center; padding: 16rpx 28rpx 20rpx;
  border-bottom: 3rpx solid var(--ink);
  position: relative; box-sizing: border-box;
}
.mast-bar { width: 240rpx; margin: 14rpx auto 0; }
.mast-bc { height: 22rpx; }
.mast-stamp {
  position: absolute; right: 36rpx; top: 60rpx;
  width: 84rpx; height: 84rpx; font-size: 19rpx;
}
.paper-mast .date {
  display: flex; justify-content: space-between;
  font-size: 20rpx; color: var(--ink-soft); letter-spacing: 2rpx;
}
.mast-title { font-size: 48rpx; font-weight: 900; letter-spacing: 8rpx; margin: 8rpx 0 4rpx; }
.slogan { font-size: 18rpx; letter-spacing: 4rpx; color: var(--ink-fade); }

/* ========== 4 格概览（在信息卡内） ========== */
.ov-row { display: flex; gap: 14rpx; }
.ov-item {
  flex: 1; text-align: center;
  background: var(--paper);
  border: 2.4rpx solid var(--ink); border-radius: 12rpx;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.ov-item b { font-size: 36rpx; display: block; font-family: var(--mono); }
.ov-item small { font-size: 18rpx; color: var(--ink-soft); font-family: var(--serif); letter-spacing: 1rpx; }
.ov-item .run { color: var(--ind); }
.ov-item .ok  { color: var(--green); }
.ov-item .verm { color: var(--verm); }

/* ========== 新闻滚动条（保留） ========== */
.ticker {
  display: flex; align-items: center;
  border: 2.4rpx solid var(--ink); border-radius: 12rpx;
  background: var(--paper);
  box-shadow: 3rpx 3rpx 0 var(--ink);
  overflow: hidden; box-sizing: border-box;
}
.ticker .tag {
  background: var(--verm); color: var(--paper);
  font-size: 20rpx; padding: 14rpx 18rpx; letter-spacing: 4rpx; flex: none;
}
.ticker-box { flex: 1; overflow: hidden; white-space: nowrap; }
.ticker .txt { font-size: 24rpx; padding: 0 16rpx; }

/* ========== 热门竞赛（保留水墨硬边卡） ========== */
.hot-card {
  display: flex; margin: 0 28rpx 24rpx; overflow: hidden;
  background: var(--cream); border: 3rpx solid var(--ink);
  border-radius: 16rpx; box-shadow: 6rpx 6rpx 0 var(--ink);
}
.hot-cover { width: 210rpx; height: 118rpx; flex-shrink: 0; align-self: center; border: 2rpx solid var(--ink); margin: 8rpx 0 8rpx 8rpx; }
.hot-info { flex: 1; padding: 18rpx 20rpx; min-width: 0; }
.hot-info b { font-size: 26rpx; display: block; font-family: var(--serif); }
.hot-info small { color: var(--ink-soft); font-size: 20rpx; display: block; margin: 4rpx 0 10rpx; }
.hot-tags { display: flex; gap: 10rpx; flex-wrap: wrap; }

/* ========== 报名进度（保留） ========== */
.prog-card {
  margin: 0 28rpx 24rpx;
  background: var(--cream); border: 3rpx solid var(--ink);
  border-radius: 16rpx; box-shadow: 6rpx 6rpx 0 var(--ink);
}
.pc-body { padding: 6rpx 24rpx 20rpx; }
.pc-row {
  display: flex; align-items: center; gap: 18rpx;
  padding: 20rpx 0; border-bottom: 2rpx dashed var(--ink-fade);
}
.pc-row:last-child { border-bottom: none; }
.pc-row .num { font-size: 30rpx; color: var(--verm); font-weight: 700; }
.pc-info { flex: 1; min-width: 0; }
.pc-info b { font-size: 25rpx; display: block; }
.pc-info small { font-size: 18rpx; color: var(--ink-fade); }
.pc-track .dot {
  display: inline-block; width: 14rpx; height: 14rpx; border-radius: 50%;
  border: 2.4rpx solid var(--ink); margin-right: 8rpx;
}
.pc-track .dot.done { background: var(--verm); border-color: var(--verm); }
.pc-row .ver { font-size: 20rpx; color: var(--ink-soft); }
.pc-empty { text-align: center; padding: 30rpx 0; color: var(--ink-soft); font-family: var(--hand); }

/* ========== 证书轮播（保留） ========== */
.cert-sw { height: 180rpx; margin: 0 28rpx 20rpx; }
.cert-slide {
  display: flex; align-items: center; gap: 20rpx; height: 152rpx;
  padding: 0 24rpx; box-sizing: border-box;
}
.cs-medal { width: 80rpx; height: 80rpx; font-size: 30rpx; flex: none; }
.cs-info { flex: 1; min-width: 0; }
.cs-info b { font-size: 27rpx; display: block; letter-spacing: 1rpx; line-height: 1.4; }
.cs-info small { font-size: 19rpx; color: var(--ink-soft); }
.cs-stamp { width: 76rpx; height: 76rpx; font-size: 17rpx; flex: none; }

/* ========== 荣誉墙（横向滚动保留） ========== */
.honor-scroll {
  white-space: nowrap; padding: 4rpx 28rpx 10rpx;
  box-sizing: border-box;
}
.honor-card {
  display: inline-flex; flex-direction: column; align-items: center; text-align: center;
  width: 300rpx; padding: 28rpx 20rpx 20rpx; margin-right: 20rpx;
  vertical-align: top; white-space: normal;
  background: var(--cream); border: 3rpx solid var(--ink);
  border-radius: 16rpx; box-shadow: 6rpx 6rpx 0 var(--ink);
  box-sizing: border-box;
}
.honor-t { font-size: 24rpx; margin-top: 14rpx; letter-spacing: 1rpx; line-height: 1.4; }
.honor-a { font-size: 19rpx; color: var(--ink-soft); margin-top: 8rpx; line-height: 1.5; }
.honor-y {
  margin-top: 12rpx; font-size: 18rpx; color: var(--verm); letter-spacing: 3rpx;
  border-top: 2rpx dashed var(--ink-fade); padding-top: 10rpx; width: 80%;
}
