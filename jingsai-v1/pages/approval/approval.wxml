<view class="sbh" style="height:{{sbh}}px"></view>

<view class="p-head">
  <text class="t serif">审 批 中 心</text>
  <text class="pill mono red" wx:if="{{badge > 0}}">{{badge}} 待办</text>
</view>

<!-- 三栏切换 -->
<view class="ap-tabs">
  <view class="ap-tab {{tab === 'todo' ? 'on' : ''}}" data-t="todo" bindtap="switchTab">待审批{{badge ? ' · ' + badge : ''}}</view>
  <view class="ap-tab {{tab === 'done' ? 'on' : ''}}" data-t="done" bindtap="switchTab">已审批</view>
  <view class="ap-tab {{tab === 'mine' ? 'on' : ''}}" data-t="mine" bindtap="switchTab">我发起的</view>
</view>

<!-- ======== 待审批 ======== -->
<block wx:if="{{tab === 'todo'}}">
  <view class="ap-card card" wx:for="{{todos}}" wx:key="_id">
    <view class="ap-head" data-id="{{item._id}}" bindtap="toggle">
      <text class="pill">{{item.typeName}}</text>
      <view class="ap-title">{{item.title || item.compTitle}}</view>
      <view class="ap-meta mono">{{item.applicantName}} · {{item.createdAt}} · 当前节点：{{item.curNodeName}}</view>
      <text class="ap-arrow">{{activeId === item._id ? '▾ 收起' : '▸ 展开'}}</text>
    </view>
    <view class="ap-detail" wx:if="{{activeId === item._id}}">
      <view class="node" wx:for="{{item.nodes}}" wx:for-item="n" wx:key="index">
        <view class="nd-dot {{n.status}}"></view>
        <view class="nd-body">
          <b>{{n.name}} <text wx:if="{{n.needSign}}" class="pill red">需手签</text></b>
          <small class="mono">{{n.approver}} · {{n.time}}</small>
          <view class="rej-note" wx:if="{{n.status === 'reject' && n.note}}">{{n.note}}</view>
        </view>
      </view>
      <view class="ap-ops">
        <button class="btn btn-ink ap-btn" data-id="{{item._id}}" data-type="{{item._type || item.type}}" bindtap="pass">✓ 通过</button>
        <button class="btn btn-verm ap-btn" data-id="{{item._id}}" data-type="{{item._type || item.type}}" bindtap="openReject">✕ 驳回</button>
      </view>
    </view>
  </view>
  <view wx:if="{{todos.length === 0}}" class="ap-empty hand">待办清零，喝杯茶吧。</view>
</block>

<!-- ======== 已审批 ======== -->
<block wx:if="{{tab === 'done'}}">
  <view class="ap-card card" wx:for="{{history}}" wx:key="_id">
    <view class="ap-head" data-id="{{item._id}}" bindtap="toggle">
      <text class="pill">{{item.typeName}}</text>
      <view class="ap-title">{{item.title || item.compTitle}}</view>
      <text class="st-pill {{item.status === 'passed' ? 'st-ok' : 'st-rej'}}">{{item.statusText}}</text>
    </view>
    <view class="ap-detail" wx:if="{{activeId === item._id}}">
      <view class="node" wx:for="{{item.nodes}}" wx:for-item="n" wx:key="index">
        <view class="nd-dot {{n.status}}"></view>
        <view class="nd-body">
          <b>{{n.name}}</b>
          <small class="mono">{{n.approver}} · {{n.time}}</small>
          <view class="rej-note" wx:if="{{n.note && n.status !== 'waiting'}}">{{n.note}}</view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{history.length === 0}}" class="ap-empty hand">还没有审批记录。</view>
</block>

<!-- ======== 我发起的 ======== -->
<block wx:if="{{tab === 'mine'}}">
  <view class="ap-card card" wx:for="{{mine}}" wx:key="_id">
    <view class="ap-head" data-id="{{item._id}}" bindtap="toggle">
      <text class="pill">{{item.typeName}}</text>
      <view class="ap-title">{{item.title || item.compTitle}}</view>
      <view class="ap-meta mono">v{{item.version}} · {{item.createdAt}}</view>
      <text class="st-pill {{item.status === 'passed' ? 'st-ok' : item.status === 'rejected' ? 'st-rej' : item.status === 'withdrawn' ? 'st-rej' : 'st-run'}}">{{item.statusText}}</text>
    </view>
    <view class="ap-detail" wx:if="{{activeId === item._id}}">
      <view class="node" wx:for="{{item.nodes}}" wx:for-item="n" wx:key="index">
        <view class="nd-dot {{n.status}}"></view>
        <view class="nd-body">
          <b>{{n.name}}</b>
          <small class="mono">{{n.approver}} · {{n.time}}</small>
          <view class="rej-note" wx:if="{{n.status === 'reject' && n.note}}">{{n.note}}</view>
        </view>
      </view>
      <view class="ap-ops" wx:if="{{item.status === 'approving'}}">
        <button class="btn btn-line ap-btn" data-id="{{item._id}}" data-type="{{item._type || item.type}}" bindtap="urge">⚡ 催办{{item.urgeCount ? '×' + item.urgeCount : ''}}</button>
        <button class="btn btn-ghost ap-btn" data-id="{{item._id}}" data-type="{{item._type || item.type}}" bindtap="withdraw">撤回</button>
      </view>
      <view class="ap-ops" wx:if="{{item.status === 'rejected'}}">
        <button class="btn btn-verm ap-btn" data-id="{{item._id}}" data-type="{{item._type || item.type}}" bindtap="resubmit">↻ 修改后重报（v{{item.version + 1}}）</button>
      </view>
    </view>
  </view>
  <view wx:if="{{mine.length === 0}}" class="ap-empty hand">你还没有发起过任何申请。</view>
</block>

<!-- ======== 驳回原因弹窗 ======== -->
<view class="mask" wx:if="{{rejShow}}" bindtap="closeReject">
  <view class="sheet" catchtap="noop">
    <view class="sh-t serif">驳回原因（至少 10 字）</view>
    <textarea class="sh-textarea" placeholder="请写明驳回理由，将退回给申请人修改" value="{{rejNote}}" bindinput="onRejNote"/>
    <view class="sh-tpls">
      <text class="chip" wx:for="{{rejTpls}}" wx:key="*this" data-i="{{index}}" bindtap="pickTpl">{{item}}</text>
    </view>
    <view class="sh-ops">
      <button class="btn btn-ghost sh-btn" bindtap="closeReject">取消</button>
      <button class="btn btn-verm sh-btn" bindtap="confirmReject">确认驳回</button>
    </view>
  </view>
</view>

<!-- ======== 手签字弹窗 ======== -->
<view class="mask" wx:if="{{signShow}}">
  <view class="sheet" catchtap="noop">
    <view class="sh-t serif">手写签字确认</view>
    <view class="sh-tip hand">请在下方框内手写你的签名（此环节按制度要求手签）</view>
    <canvas type="2d" id="signCanvas" class="sign-canvas"
            bindtouchstart="signStart" bindtouchmove="signMove" bindtouchend="signEnd"></canvas>
    <view class="sh-ops">
      <button class="btn btn-ghost sh-btn" bindtap="clearSign">清除重写</button>
      <button class="btn btn-ghost sh-btn" bindtap="cancelSign">取消</button>
      <button class="btn btn-ink sh-btn" bindtap="confirmSign">签字通过</button>
    </view>
  </view>
</view>
