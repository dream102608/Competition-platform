/* pages/approval/approval.wxss —— 审批中心 */
.ap-tabs { display: flex; margin: 20rpx 28rpx; border: 3rpx solid var(--ink); }
.ap-tab {
  flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx;
  font-family: var(--serif); font-weight: 900; letter-spacing: 3rpx;
  background: var(--cream); color: var(--ink-soft);
}
.ap-tab.on { background: var(--verm); color: var(--paper); }

.ap-card { margin: 0 28rpx 22rpx; padding: 22rpx 24rpx; }
.ap-head { position: relative; }
.ap-title { font-size: 28rpx; font-weight: 900; font-family: var(--serif); margin: 10rpx 0 6rpx; }
.ap-meta { font-size: 19rpx; color: var(--ink-soft); }
.ap-arrow { position: absolute; right: 0; top: 0; font-size: 20rpx; color: var(--ink-fade); }

.ap-detail { margin-top: 16rpx; border-top: 2rpx dashed var(--ink-fade); padding-top: 16rpx; }
.node { display: flex; gap: 16rpx; padding: 10rpx 0; }
.nd-dot {
  width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; margin-top: 8rpx;
  border: 3rpx solid var(--ink); background: transparent;
}
.nd-dot.pass { background: var(--green); border-color: var(--green); }
.nd-dot.reject { background: var(--verm); border-color: var(--verm); }
.nd-dot.waiting { background: var(--marker); }
.nd-body b { font-size: 25rpx; display: block; }
.nd-body small { font-size: 18rpx; color: var(--ink-fade); }

.ap-ops { display: flex; gap: 18rpx; margin-top: 18rpx; }
.ap-btn { flex: 1; height: 76rpx; font-size: 26rpx; letter-spacing: 3rpx; }

.ap-empty { text-align: center; padding: 80rpx 0; color: var(--ink-soft); font-size: 28rpx; }

/* 弹窗专属 */
.sh-tip { font-size: 24rpx; margin-bottom: 14rpx; color: var(--ink-soft); }
.sh-textarea {
  width: 100%; box-sizing: border-box; min-height: 140rpx;
  border: 2.4rpx solid var(--ink); background: var(--paper-2);
  padding: 16rpx; font-size: 26rpx; border-radius: 12rpx;
}
.sh-tpls { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.sh-tpls .chip {
  display: inline-block; font-size: 20rpx; padding: 6rpx 16rpx;
  border: 2rpx solid var(--ink); background: var(--paper-2);
  font-family: var(--mono); border-radius: 999rpx;
}
.sign-canvas {
  width: 100%; height: 300rpx; background: #fff;
  border: 2.4rpx solid var(--ink); border-radius: 12rpx;
}
