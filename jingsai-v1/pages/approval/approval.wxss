/* S6 审批中心 · 签批版式 */
.h-ic { font-size: 38rpx; color: var(--ink); }
.p-head { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 28rpx; }
.h-right { display: flex; align-items: center; gap: 18rpx; }
.exp-btn {
  font-size: 20rpx; color: var(--verm); border: 2rpx solid var(--verm);
  padding: 6rpx 14rpx; letter-spacing: 2rpx; font-weight: 700;
}

.ap-tabs { display: flex; gap: 0; border-bottom: 3rpx solid var(--ink); margin: 0 28rpx; }
.at {
  padding: 18rpx 26rpx; font-size: 27rpx; letter-spacing: 3rpx;
  font-family: "Noto Serif SC", "SimSun", serif; font-weight: 700;
  color: var(--ink-fade); border: 3rpx solid transparent; border-bottom: none;
}
.at.on {
  color: var(--ink); background: var(--cream);
  border-color: var(--ink); position: relative; top: 3rpx;
}
.bdg {
  margin-left: 10rpx; font-size: 19rpx; color: var(--paper);
  background: var(--verm); padding: 0 10rpx; border-radius: 40rpx;
}

.ap-empty { margin: 40rpx 28rpx; padding: 60rpx 0; text-align: center; }
.ap-empty .hand { font-size: 32rpx; color: var(--verm); }
.ap-empty .sub { margin-top: 10rpx; font-size: 17rpx; color: var(--ink-fade); letter-spacing: 4rpx; }

.ap-item { margin: 24rpx 28rpx; padding: 24rpx; }
.ai-h { display: flex; align-items: center; gap: 16rpx; }
.ai-t { flex: 1; min-width: 0; }
.ai-t b { font-size: 28rpx; display: block; line-height: 1.5; }
.who { font-size: 18rpx; color: var(--ink-fade); margin-top: 6rpx; display: flex; align-items: center; gap: 12rpx; }
.arrow { font-size: 30rpx; color: var(--ink-fade); }

.seal.mini { width: 118rpx; height: 118rpx; }
.seal.mini .stxt { font-size: 21rpx; }

/* 签批轨迹 */
.ap-track { margin-top: 22rpx; border-left: 4rpx solid var(--ink); padding-left: 28rpx; }
.ap-step { position: relative; display: flex; align-items: baseline; gap: 14rpx; padding: 12rpx 0; }
.ap-step .st {
  position: absolute; left: -48rpx; top: 14rpx;
  width: 32rpx; height: 32rpx; border-radius: 50%;
  background: var(--paper); border: 3rpx solid var(--ink-fade);
  color: var(--paper); font-size: 18rpx; line-height: 28rpx; text-align: center;
}
.ap-step.ok .st { background: var(--verm); border-color: var(--verm-deep); }
.ap-step.rej .st { background: var(--ink); border-color: var(--ink); }
.asn { flex: 1; min-width: 0; }
.asn b { font-size: 26rpx; display: block; }
.ap-step.ok .asn b { color: var(--ink); }
.ap-step.rej .asn b { color: var(--verm); text-decoration: line-through; text-decoration-thickness: 3rpx; }
.asn small { font-size: 19rpx; color: var(--ink-fade); }
.tm { font-size: 17rpx; color: var(--ink-fade); }
/* 我经手的节点：荧光黄左标 + 墨色粗体 */
.ap-step.mine { border-left: 8rpx solid var(--marker); padding-left: 12rpx; }
.ap-step.mine .asn b { font-weight: 900; }

.final-seal { display: flex; justify-content: flex-end; padding: 20rpx 0 0; }

/* 超时条 */
.overtime {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 16rpx; padding: 14rpx 18rpx;
  border: 3rpx dashed var(--verm); background: rgba(200, 68, 42, .06);
  color: var(--verm-deep); font-size: 22rpx;
}
.ot-ic { color: var(--verm); font-size: 28rpx; }

/* 签名区 */
.sign-area {
  margin-top: 20rpx; border: 3rpx dashed var(--ink-fade);
  background: rgba(244, 237, 223, .4);
  padding: 24rpx; text-align: center;
}
.sh { font-size: 22rpx; letter-spacing: 8rpx; color: var(--ink-soft); margin-bottom: 10rpx; }
.sig { font-size: 64rpx; color: var(--ink); transform: rotate(-3deg); line-height: 1.3; }
.sig-sub { margin-top: 10rpx; font-size: 15rpx; color: var(--ink-fade); }

/* 动作按钮 */
.ap-actions, .mine-acts { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ap-btn { flex: 1; height: 84rpx; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.ap-btn.reject { border: 3rpx solid var(--verm); color: var(--verm); background: transparent; }
.ap-btn.ghost { border: 3rpx solid var(--ink); color: var(--ink); background: transparent; letter-spacing: 3rpx; font-weight: 400; font-size: 25rpx; }

/* 节点内的签名缩略图 */
.sig-img { display: block; width: 220rpx; height: 72rpx; margin-top: 8rpx; border: 2rpx dashed var(--ink-fade); background: var(--cream); }

/* 附件预览行 */
.plan-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 18rpx; padding: 16rpx 18rpx;
  border: 2rpx solid var(--ink); background: var(--cream);
}
.pr-ic { font-size: 26rpx; color: var(--verm); }
.pr-name { flex: 1; font-size: 24rpx; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pr-go { font-size: 22rpx; color: var(--verm); font-weight: 700; }

/* 队伍管理 */
.team-edit { margin-top: 18rpx; padding: 20rpx 18rpx; border: 3rpx dashed var(--ink-fade); }
.te-t { font-size: 24rpx; font-weight: 900; letter-spacing: 4rpx; color: var(--ink-soft); }
.te-members { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.te-m {
  position: relative; display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 14rpx; border: 2rpx solid var(--ink); background: var(--paper);
}
.te-m.lead { background: var(--marker); }
.te-ava { width: 48rpx; height: 48rpx; border: 2rpx solid var(--ink); }
.te-name { font-size: 22rpx; color: var(--ink); }
.te-x {
  width: 34rpx; height: 34rpx; line-height: 30rpx; text-align: center;
  border: 2rpx solid var(--verm); color: var(--verm); font-size: 20rpx;
}
.te-add {
  width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed var(--verm); color: var(--verm); font-size: 40rpx;
}
.te-tip { font-size: 20rpx; color: var(--ink-fade); margin-top: 14rpx; }

/* 弹层 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(26, 24, 21, .55); z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.sig-modal, .pool-modal { width: 620rpx; padding: 36rpx 32rpx; }
.sm-h { font-size: 34rpx; font-weight: 900; letter-spacing: 4rpx; color: var(--ink); text-align: center; }
.sig-canvas {
  width: 100%; height: 260rpx; margin-top: 24rpx;
  border: 3rpx solid var(--ink); background: var(--cream);
}
.sm-tip { text-align: center; font-size: 20rpx; color: var(--ink-fade); margin-top: 14rpx; }
.sm-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }

/* 邀请池 */
.pool-list { margin-top: 20rpx; }
.pool-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 6rpx; border-bottom: 2rpx dashed var(--ink-fade);
}
.pool-empty { text-align: center; padding: 30rpx 0; color: var(--ink-fade); }
.pool-modal .btn { width: 100%; margin-top: 24rpx; }

/* ========== V1.3：报表入口 / 链上指纹 / 防伪校验 ========== */
.exp-btn.ink { color: var(--ink); border-color: var(--ink); }
.sig-meta {
  display: block; margin-top: 6rpx;
  font-size: 16rpx; color: var(--ink-fade); letter-spacing: 1rpx;
}
.vrf-modal { width: 660rpx; padding: 36rpx 32rpx; }
.vrf-meta { text-align: center; margin-top: 12rpx; font-size: 18rpx; color: var(--ink-fade); }
.vrf-note { text-align: center; color: var(--verm); font-size: 22rpx; margin-top: 8rpx; }
.vrf-list { margin-top: 18rpx; max-height: 52vh; overflow-y: auto; }
.vrf-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 4rpx; border-bottom: 2rpx dashed var(--ink-fade); }
.vrf-ok {
  width: 36rpx; height: 36rpx; flex-shrink: 0; border-radius: 50%;
  text-align: center; line-height: 32rpx; font-size: 19rpx;
  border: 3rpx solid var(--ink-fade); color: var(--ink-fade);
}
.vrf-row.ok .vrf-ok { color: var(--green); border-color: var(--green); }
.vrf-row.bad .vrf-ok { color: var(--verm); border-color: var(--verm); }
.vrf-name { flex: 1; font-size: 24rpx; min-width: 0; }
.vrf-fp { font-size: 17rpx; color: var(--ink-fade); }
.vrf-verdict {
  margin-top: 22rpx; padding: 20rpx; text-align: center;
  border: 3rpx solid var(--ink); display: flex; flex-direction: column; gap: 6rpx;
}
.vrf-verdict.pass { background: rgba(62, 107, 79, .10); }
.vrf-verdict.fail { background: rgba(200, 68, 42, .10); }
.vrf-verdict b { font-size: 30rpx; letter-spacing: 3rpx; }
.vrf-verdict .verm-t { color: var(--verm-deep); }
.vrf-verdict small { font-size: 17rpx; color: var(--ink-fade); }
