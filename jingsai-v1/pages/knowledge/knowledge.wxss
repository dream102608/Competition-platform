/* pages/knowledge/knowledge.wxss —— 知识广场 V3.0（参考图风格重排） */

/* 排序（保留） */
.kn-sort { display: flex; gap: 24rpx; padding: 12rpx 28rpx 0; }
.sp { font-size: 22rpx; color: var(--ink-fade); }
.sp.on { color: var(--verm); font-weight: 700; }

/* 知识卡（保留水墨硬边 + 加大圆角） */
.kn-card {
  margin: 16rpx 28rpx; padding: 24rpx 28rpx;
  background: var(--cream); border: 3rpx solid var(--ink); border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink);
  box-sizing: border-box;
}
.kn-flags { display: flex; gap: 10rpx; flex-wrap: wrap; margin-bottom: 10rpx; }
.kn-title {
  font-size: 30rpx; font-weight: 900; line-height: 1.5;
  font-family: var(--serif); letter-spacing: 1rpx;
}
.kn-content {
  font-size: 26rpx; color: var(--ink-soft); margin: 10rpx 0; line-height: 1.7;
  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.kn-more { font-size: 22rpx; color: var(--verm); letter-spacing: 2rpx; }
.kn-meta { font-size: 19rpx; color: var(--ink-fade); }
.kn-ops { display: flex; gap: 30rpx; margin-top: 14rpx; border-top: 2rpx dashed var(--ink-fade); padding-top: 14rpx; }
.op { font-size: 24rpx; color: var(--ink-soft); }

/* FAB（发布按钮，参考图浮动圆按钮风格） */
.kn-fab {
  position: fixed; right: 32rpx; bottom: 60rpx; z-index: 50;
  width: 110rpx; height: 110rpx; border-radius: 50%;
  background: var(--verm); color: var(--paper);
  border: 3rpx solid var(--verm-deep);
  box-shadow: 6rpx 6rpx 0 rgba(160, 53, 33, .35);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--serif); font-size: 36rpx; font-weight: 900;
  letter-spacing: 2rpx;
}

/* 表单行内 */
.fm-line { margin-bottom: 16rpx; }
.kn-input {
  background: var(--paper-2); border: 2.4rpx solid var(--ink);
  box-shadow: 3rpx 3rpx 0 var(--ink); padding: 14rpx 20rpx; font-size: 26rpx;
  border-radius: 12rpx; box-sizing: border-box;
}
.kn-textarea {
  width: 100%; box-sizing: border-box; min-height: 200rpx;
  border: 2.4rpx solid var(--ink); background: var(--paper-2);
  padding: 16rpx; font-size: 26rpx; border-radius: 12rpx;
}
.kn-tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }

/* 评论列表 */
.cm-list { max-height: 500rpx; overflow-y: auto; }
.cm-item { padding: 14rpx 0; border-bottom: 2rpx dashed var(--ink-fade); }
.cm-item b { font-size: 24rpx; }
.cm-item small { font-size: 18rpx; color: var(--ink-fade); }
.cm-content { font-size: 25rpx; color: var(--ink-soft); margin-top: 4rpx; }
.kn-no-cm { text-align: center; color: var(--ink-soft); padding: 30rpx 0; }
.cm-input-row { display: flex; gap: 14rpx; margin-top: 18rpx; }
.cm-input { flex: 1; }
.cm-send { width: 140rpx; height: 76rpx; font-size: 24rpx; letter-spacing: 2rpx; }
.cm-send.btn::after { border: none; }

/* 文章详情弹窗（在通用 .sheet 上做文章专属） */
.dt-sheet { max-height: 86vh; padding: 36rpx; display: flex; flex-direction: column; }
.dt-title { font-size: 32rpx; font-weight: 900; font-family: var(--serif); line-height: 1.5; }
.dt-meta { font-size: 20rpx; color: var(--ink-fade); margin: 10rpx 0 18rpx; font-family: var(--mono); }
.dt-scroll { flex: 1; min-height: 200rpx; max-height: 52vh; }
.dt-content { font-size: 27rpx; line-height: 1.9; color: var(--ink); }
.dt-src {
  display: flex; align-items: center; gap: 14rpx; margin-top: 22rpx;
  background: rgba(200, 68, 42, .06); border: 2rpx dashed var(--verm);
  padding: 16rpx 20rpx; border-radius: 10rpx;
}
.dt-src .name { flex: 1; font-size: 22rpx; color: var(--verm); }
.dt-src .cpy { font-size: 22rpx; color: var(--paper); background: var(--verm); padding: 6rpx 20rpx; border-radius: 6rpx; }
.dt-cm-t {
  font-size: 24rpx; font-weight: 900; margin: 24rpx 0 6rpx;
  color: var(--ink-soft); font-family: var(--serif); letter-spacing: 2rpx;
}
