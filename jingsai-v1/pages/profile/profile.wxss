/* pages/profile/profile.wxss —— 我的 V3.0（参考图风格重排） */

/* banner 内的头像（大圆角色块） */
.pf-avatar {
  width: 110rpx; height: 110rpx; border-radius: 50%;
  background: var(--paper); color: var(--ink);
  border: 3rpx solid var(--paper);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 900; flex: none;
}

/* 信息卡内的 4 格统计（与首页一致） */
.ov-row { display: flex; gap: 14rpx; }
.ov-item {
  flex: 1; text-align: center;
  background: var(--paper); border: 2.4rpx solid var(--ink); border-radius: 12rpx;
  padding: 16rpx 0; box-sizing: border-box;
}
.ov-item b { font-size: 36rpx; display: block; font-family: var(--mono); }
.ov-item small { font-size: 18rpx; color: var(--ink-soft); font-family: var(--serif); letter-spacing: 1rpx; }
.ov-item .run { color: var(--ind); }
.ov-item .ok  { color: var(--green); }
.ov-item .verm { color: var(--verm); }

/* 报名卷宗 / 证书行 */
.pf-reg {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 0; border-bottom: 2rpx dashed var(--ink-fade);
}
.pf-reg:last-child { border-bottom: none; }
.pr-l { flex: 1; min-width: 0; }
.pr-l b { font-size: 26rpx; display: block; }
.pr-l small { font-size: 18rpx; color: var(--ink-fade); }

/* 证书行 */
.pf-cert {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 0; border-bottom: 2rpx dashed var(--ink-fade);
}
.pf-cert:last-of-type { border-bottom: none; }
.pc-ic { font-size: 40rpx; flex: none; }
.pc-del { font-size: 22rpx; color: var(--verm); letter-spacing: 2rpx; padding: 8rpx 4rpx 8rpx 16rpx; }
.pf-cert-btn { width: 100%; margin-top: 18rpx; height: 72rpx; font-size: 24rpx; letter-spacing: 3rpx; }
.pf-cert-btn.btn::after { border: none; }

/* 底部操作 */
.pf-ops { display: flex; flex-direction: column; gap: 16rpx; }
.pf-btn { width: 100%; height: 80rpx; font-size: 24rpx; letter-spacing: 3rpx; }
.pf-btn.btn::after { border: none; }

/* 输入行 */
.kn-input {
  background: var(--paper-2); border: 2.4rpx solid var(--ink);
  padding: 14rpx 20rpx; font-size: 26rpx; border-radius: 12rpx;
  box-sizing: border-box;
}
.fm-line { margin-bottom: 16rpx; }
