/* pages/export/export.wxss —— 数据导出（教师/管理） */

.ad-deny {
  text-align: center; padding: 100rpx 60rpx; color: var(--ink-soft);
  font-size: 28rpx; font-family: var(--hand); line-height: 1.9;
}

.exp-card {
  margin: 0 28rpx 22rpx; padding: 22rpx 26rpx 24rpx;
  background: var(--cream); border: 3rpx solid var(--ink); border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink); box-sizing: border-box;
}
.exp-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.exp-t { font-size: 30rpx; font-weight: 900; letter-spacing: 4rpx; }
.exp-head .pill.small { font-size: 18rpx; padding: 4rpx 12rpx; }
.exp-desc {
  font-size: 21rpx; color: var(--ink-soft); line-height: 1.7;
  margin: 8rpx 0 16rpx; letter-spacing: 1rpx;
}
.exp-filter { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.exp-pick {
  flex: 1; min-width: 0; box-sizing: border-box;
  background: var(--paper); padding: 14rpx 18rpx;
  border: 2.4rpx solid var(--ink); border-radius: 10rpx;
  font-size: 24rpx; letter-spacing: 1rpx;
}
.exp-btn {
  width: 100%; height: 88rpx; font-size: 26rpx; letter-spacing: 4rpx;
}

.exp-note {
  font-size: 22rpx; color: var(--ink-soft); line-height: 2; padding: 6rpx 4rpx;
  letter-spacing: 1rpx;
}
.exp-note .red { color: var(--verm); }
.exp-note .mono { font-family: var(--mono); }

/* 窄屏兜底（iPhone SE 320 宽度） */
@media (max-width: 340px) {
  .exp-pick { font-size: 21rpx; padding: 12rpx 14rpx; }
  .exp-t { font-size: 26rpx; letter-spacing: 3rpx; }
}