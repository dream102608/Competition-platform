<view class="sbh" style="height:{{sbh}}px"></view>

<view class="p-head">
  <text class="t serif">培 训 中 心</text>
  <text class="pill mono red" wx:if="{{canPublish}}" bindtap="openPub">+ 发布</text>
</view>

<!-- Tab -->
<view class="tr-tabs">
  <view class="tr-tab {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key"
        data-k="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
</view>

<!-- 培训卡片 -->
<view class="tr-card card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="openDetail">
  <image class="tr-cover" src="{{item.cover}}" mode="aspectFill"/>
  <view class="tr-body">
    <view class="tr-title">{{item.title}}</view>
    <view class="tr-meta mono">讲师：{{item.lecturer}} · {{item.startTime}}</view>
    <view class="tr-tags">
      <text class="pill">{{item.mode}}</text>
      <text class="st-pill {{item.state === 'done' ? 'st-rej' : 'st-run'}}">{{item.stateText}}</text>
      <text class="tr-count mono">{{item.signupCount || 0}} 人报名</text>
    </view>
  </view>
</view>
<view wx:if="{{list.length === 0}}" class="tr-empty hand">这个分类下暂时没有培训。</view>

<!-- 详情弹窗 -->
<view class="mask" wx:if="{{detailShow}}" bindtap="closeDetail">
  <view class="sheet" catchtap="noop" wx:if="{{detail}}">
    <view class="sh-t serif">{{detail.title}}</view>
    <view class="tr-d-meta mono">讲师：{{detail.lecturer}} · {{detail.mode}} · {{detail.place}}</view>
    <view class="tr-d-meta mono">{{detail.startTime}} 至 {{detail.endTime}}</view>
    <view class="tr-d-intro">{{detail.intro}}</view>
    <view class="sh-ops">
      <button class="btn btn-line sh-btn" bindtap="goCheckin">📍 培训签到</button>
      <button wx:if="{{mySignupIds.indexOf(detail._id) > -1}}" class="btn btn-ghost sh-btn" data-id="{{detail._id}}" catchtap="cancel">取消报名</button>
      <button wx:else class="btn btn-verm sh-btn" data-id="{{detail._id}}" catchtap="signup">立即报名</button>
    </view>
  </view>
</view>

<!-- 发布培训弹窗（教师） -->
<view class="mask" wx:if="{{pubShow}}" bindtap="closePub">
  <view class="sheet" catchtap="noop">
    <view class="sh-t serif">发 布 培 训</view>
    <input class="kn-input fm-line" placeholder="培训标题" value="{{pub.title}}" data-k="title" bindinput="onPubField"/>
    <input class="kn-input fm-line" placeholder="讲师姓名" value="{{pub.lecturer}}" data-k="lecturer" bindinput="onPubField"/>
    <picker mode="date" data-k="startTime" bindchange="onPubDate">
      <view class="kn-input fm-line">开始日期：{{pub.startTime || '点击选择'}} ▾</view>
    </picker>
    <input class="kn-input fm-line" placeholder="地点 / 线上链接" value="{{pub.place}}" data-k="place" bindinput="onPubField"/>
    <textarea class="kn-textarea" placeholder="培训介绍" value="{{pub.intro}}" data-k="intro" bindinput="onPubField"/>
    <view class="sh-ops">
      <button class="btn btn-ghost sh-btn" bindtap="closePub">取消</button>
      <button class="btn btn-verm sh-btn" bindtap="submitPub">发布</button>
    </view>
  </view>
</view>
