/* pages/training/training.wxss —— 培训中心 */
.tr-tabs { display: flex; margin: 20rpx 28rpx; border: 3rpx solid var(--ink); }
.tr-tab {
  flex: 1; text-align: center; padding: 14rpx 0; font-size: 24rpx;
  font-family: var(--serif); font-weight: 900;
  background: var(--cream); color: var(--ink-soft);
}
.tr-tab.on { background: var(--ink); color: var(--paper); }

.tr-card { display: flex; margin: 0 28rpx 20rpx; overflow: hidden; }
.tr-cover { width: 210rpx; height: 118rpx; flex-shrink: 0; align-self: center; border: 2rpx solid var(--ink); }
.tr-body { flex: 1; padding: 16rpx 20rpx; }
.tr-title { font-family: var(--serif); font-weight: 900; font-size: 28rpx; }
.tr-meta { font-size: 19rpx; color: var(--ink-soft); margin: 8rpx 0; }
.tr-tags { display: flex; gap: 10rpx; align-items: center; }
.tr-count { font-size: 19rpx; color: var(--ink-fade); }
.tr-empty { text-align: center; padding: 80rpx 0; color: var(--ink-soft); }

/* 弹窗基础用 app.wxss 通用；本页 sheet 需要 max-height */
.sheet { max-height: 80vh; overflow-y: auto; }
.tr-d-meta { font-size: 20rpx; color: var(--ink-soft); margin-bottom: 8rpx; }
.tr-d-intro { font-size: 26rpx; color: var(--ink-soft); line-height: 1.8; margin: 16rpx 0; }
.kn-input { background: var(--paper-2); border: 2.4rpx solid var(--ink); padding: 14rpx 20rpx; font-size: 26rpx; border-radius: 12rpx; box-sizing: border-box; }
.fm-line { margin-bottom: 16rpx; }
.kn-textarea { width: 100%; box-sizing: border-box; min-height: 160rpx; border: 2.4rpx solid var(--ink); background: var(--paper-2); padding: 16rpx; font-size: 26rpx; border-radius: 12rpx; }
