/* pages/plaza/plaza.wxss —— V1.4 知识广场（报纸副刊版式） */
.pl-head {
  display: flex; align-items: center;
  padding: 24rpx 32rpx 12rpx;
}
.pl-back {
  width: 56rpx; height: 56rpx; flex-shrink: 0;
  border: 2rpx solid var(--ink); background: var(--cream);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; line-height: 1; margin-right: 16rpx;
}
.pl-t { font-size: 40rpx; font-weight: 900; letter-spacing: 6rpx; color: var(--ink); flex: 1; }
.pl-en { font-size: 15rpx; color: var(--ink-fade); letter-spacing: 3rpx; }
.pl-lead {
  padding: 0 36rpx 18rpx; font-size: 24rpx; color: var(--ink-soft);
  border-bottom: 2rpx solid var(--ink);
}

/* 栏目页签（报纸栏目条） */
.pl-tabs { display: flex; padding: 22rpx 28rpx 0; gap: 16rpx; }
.pl-tab {
  flex: 1; display: flex; align-items: baseline; justify-content: center; gap: 8rpx;
  padding: 16rpx 0; border: 2rpx solid var(--ink-fade);
  color: var(--ink-fade);
}
.pl-tab-cn { font-size: 26rpx; font-weight: 700; letter-spacing: 2rpx; }
.pl-tab-en { font-size: 13rpx; letter-spacing: 1rpx; }
.pl-tab-n {
  font-size: 18rpx; border: 2rpx solid currentColor;
  padding: 0 8rpx; line-height: 26rpx;
}
.pl-tab.on {
  background: var(--ink); border-color: var(--ink); color: var(--cream);
}

/* ---- 经验帖摘要卡 ---- */
.ps-card { margin: 22rpx 28rpx 0; padding: 24rpx 26rpx 20rpx; }
.ps-top { display: flex; justify-content: space-between; align-items: center; }
.ps-comp { font-size: 17rpx; color: var(--verm); font-weight: 700; letter-spacing: 1rpx; }
.ps-date { font-size: 17rpx; color: var(--ink-fade); }
.ps-title {
  font-size: 34rpx; font-weight: 900; line-height: 1.45; color: var(--ink);
  margin-top: 12rpx;
}
.ps-quo { color: var(--verm); font-weight: 900; margin-right: 6rpx; }
.ps-brief {
  font-size: 24rpx; color: var(--ink-soft); line-height: 1.7; margin-top: 12rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.ps-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx dashed var(--ink-fade);
}
.ps-author { font-size: 21rpx; color: var(--ink-fade); flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ps-meta { display: flex; align-items: center; gap: 18rpx; font-size: 18rpx; color: var(--ink-fade); flex-shrink: 0; }
.ps-go { color: var(--verm); font-weight: 700; }

/* ---- 获奖名单 ---- */
.wl-card { margin: 22rpx 28rpx 0; padding: 24rpx 26rpx 10rpx; }
.wl-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2rpx solid var(--ink); padding-bottom: 14rpx; }
.wl-season { font-size: 32rpx; font-weight: 900; color: var(--ink); }
.wl-comp { font-size: 18rpx; color: var(--ink-fade); }
.wl-row {
  display: flex; align-items: center; gap: 18rpx;
  padding: 16rpx 0; border-bottom: 1rpx dashed var(--ink-fade);
}
.wl-prize {
  flex-shrink: 0; min-width: 130rpx; text-align: center;
  padding: 8rpx 10rpx; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx;
  border: 2rpx solid var(--ink);
}
.g-gold   { background: var(--verm); color: var(--cream); border-color: var(--verm-deep); }
.g-silver { background: var(--ind); color: var(--cream); border-color: var(--ink); }
.g-bronze { background: var(--paper-2); color: var(--ink); }
.wl-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.wl-info b { font-size: 27rpx; color: var(--ink); }
.wl-info small { font-size: 18rpx; color: var(--ink-fade); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.wl-tea { flex-shrink: 0; font-size: 18rpx; color: var(--ink-soft); }

/* ---- 模板库 ---- */
.tpl-card { margin: 22rpx 28rpx 0; padding: 24rpx 26rpx; }
.tpl-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.tpl-top b { font-size: 30rpx; color: var(--ink); flex: 1; }
.tpl-tag {
  flex-shrink: 0; font-size: 18rpx; color: var(--verm); border: 2rpx solid var(--verm);
  padding: 4rpx 12rpx; font-weight: 700;
}
.tpl-desc { font-size: 23rpx; color: var(--ink-soft); line-height: 1.7; margin-top: 12rpx; }
.tpl-copy {
  margin-top: 20rpx; height: 72rpx; line-height: 72rpx;
  background: var(--cream); border: 2rpx solid var(--ink);
  font-size: 25rpx; font-weight: 700; color: var(--ink);
  border-radius: 0;
}
.tpl-copy::after { border: none; }
.tpl-copy:active { background: var(--marker); }

.pl-note { margin: 20rpx 36rpx 0; font-size: 17rpx; color: var(--ink-fade); line-height: 1.7; }
.pl-foot { text-align: center; font-size: 17rpx; color: var(--ink-fade); letter-spacing: 2rpx; padding: 44rpx 0 70rpx; }

/* ---- 全文弹层 ---- */
.pl-mask {
  position: fixed; inset: 0; z-index: 99;
  background: rgba(26, 24, 21, 0.55);
  display: flex; align-items: flex-end;
}
.pl-modal {
  width: 100%; background: var(--paper);
  border-top: 6rpx solid var(--ink);
  padding: 28rpx 34rpx 34rpx;
  box-sizing: border-box;
  max-height: 86vh; display: flex; flex-direction: column;
}
.pm-top { display: flex; justify-content: space-between; align-items: center; }
.pm-comp { font-size: 18rpx; color: var(--verm); font-weight: 700; letter-spacing: 1rpx; }
.pm-date { font-size: 17rpx; color: var(--ink-fade); }
.pm-scroll { flex: 1; margin-top: 16rpx; max-height: 62vh; }
.pm-title { font-size: 38rpx; font-weight: 900; line-height: 1.5; color: var(--ink); }
.pm-author { font-size: 22rpx; color: var(--ink-fade); margin-top: 12rpx; }
.pm-rule { height: 2rpx; background: var(--ink); margin: 20rpx 0; }
.pm-para {
  font-size: 27rpx; line-height: 1.85; color: var(--ink-soft);
  margin-bottom: 22rpx; text-align: justify;
  text-indent: 2em;
}
.pm-end { text-align: center; color: var(--ink-fade); font-size: 22rpx; padding: 8rpx 0 16rpx; }
.pm-close {
  margin-top: 10rpx; height: 80rpx; line-height: 80rpx;
  background: var(--ink); color: var(--cream);
  font-size: 27rpx; font-weight: 700; letter-spacing: 4rpx; border-radius: 0;
}
.pm-close::after { border: none; }
.pm-close.verm { background: var(--verm); }

/* ---- V1.5：发帖工具行 + 审核提示 ---- */
.ps-tools { display: flex; align-items: center; gap: 18rpx; margin: 22rpx 28rpx 0; }
.ps-pub {
  flex: 1; height: 76rpx; line-height: 76rpx; margin: 0;
  background: var(--verm); color: var(--cream);
  border: 2rpx solid var(--verm-deep); border-radius: 0;
  font-size: 26rpx; font-weight: 700; letter-spacing: 2rpx;
}
.ps-pub::after { border: none; }
.ps-pub:active { opacity: .85; }
.ps-my {
  flex-shrink: 0; font-size: 22rpx; color: var(--ink);
  border: 2rpx solid var(--ink); padding: 12rpx 22rpx; font-weight: 700;
  background: var(--cream);
}
.pub-banner {
  margin: 18rpx 28rpx 0; padding: 16rpx 22rpx;
  background: var(--marker); border: 2rpx solid var(--ink);
  font-size: 23rpx; color: var(--ink);
}

/* ---- V1.5：经验帖卡互动（覆盖旧 foot 布局为双行） ---- */
.ps-foot { flex-direction: column; align-items: stretch; gap: 14rpx; }
.ps-acts { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; }
.ps-act {
  font-size: 19rpx; padding: 6rpx 16rpx; font-weight: 700;
  border: 2rpx solid var(--ink-fade); color: var(--ink-soft);
  background: var(--paper);
}
.ps-act.on { border-color: var(--verm); color: var(--verm); background: #FBF0E8; }
.ps-act:active { background: var(--marker); }

/* ---- V1.5：发帖表单弹层 ---- */
.pub-modal { max-height: 92vh; }
.pub-scroll { flex: 1; margin-top: 18rpx; max-height: 66vh; }
.pub-row { display: flex; align-items: center; gap: 18rpx; margin-bottom: 22rpx; }
.pub-row.col { flex-direction: column; align-items: stretch; gap: 10rpx; }
.pub-label {
  flex-shrink: 0; width: 88rpx; font-size: 25rpx; font-weight: 700; color: var(--ink);
}
.pub-input {
  flex: 1; height: 76rpx; padding: 0 20rpx;
  background: var(--paper-2); border: 2rpx solid var(--ink-fade);
  font-size: 25rpx; color: var(--ink);
}
.pub-picker { flex: 1; }
.pub-pick {
  height: 76rpx; line-height: 76rpx; padding: 0 20rpx;
  background: var(--paper-2); border: 2rpx solid var(--ink-fade);
  font-size: 25rpx; color: var(--ink);
}
.pub-pick.ph { color: var(--ink-fade); }
.pub-ta {
  width: 100%; height: 300rpx; box-sizing: border-box; padding: 18rpx 20rpx;
  background: var(--paper-2); border: 2rpx solid var(--ink-fade);
  font-size: 25rpx; line-height: 1.7; color: var(--ink);
}
.pub-count { align-self: flex-end; font-size: 18rpx; color: var(--ink-fade); }
.pub-note { font-size: 21rpx; color: var(--ink-fade); line-height: 1.7; padding-bottom: 6rpx; }

/* ---- V1.5：我的投稿弹层 ---- */
.my-item {
  padding: 22rpx 0; border-bottom: 1rpx dashed var(--ink-fade);
}
.my-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.my-title { font-size: 28rpx; font-weight: 900; color: var(--ink); flex: 1; }
.my-st {
  flex-shrink: 0; font-size: 19rpx; font-weight: 700; padding: 4rpx 14rpx;
  border: 2rpx solid var(--ink);
}
.st-p { background: var(--marker); color: var(--ink); border-color: var(--ink); }
.st-w { background: var(--paper-2); color: var(--ink-fade); border-color: var(--ink-fade); }
.my-sub { font-size: 18rpx; color: var(--ink-fade); margin-top: 8rpx; }
.my-brief {
  font-size: 22rpx; color: var(--ink-soft); line-height: 1.6; margin-top: 8rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.my-act {
  display: inline-block; margin-top: 14rpx; font-size: 20rpx;
  color: var(--verm); border: 2rpx solid var(--verm); padding: 6rpx 18rpx;
}
.my-empty { text-align: center; font-size: 25rpx; color: var(--ink-soft); padding: 60rpx 20rpx; }
